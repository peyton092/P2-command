rules_version = '2';

// P2 Bid Tracker — only signed-in team members can read or write bids.
// Team members are created in the Firebase console (Authentication > Users).
service cloud.firestore {
  match /databases/{database}/documents {
    match /bids/{bidId} {
      allow read, write: if request.auth != null;
    }
    // Lock down everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
