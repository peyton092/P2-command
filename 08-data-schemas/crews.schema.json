{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Crew Member",
  "description": "P2 Electrical Contracting — Crew/employee record schema",
  "type": "object",
  "required": ["employee_id", "name", "role", "status"],
  "properties": {
    "employee_id": { "type": "string" },
    "name": { "type": "string" },
    "role": {
      "type": "string",
      "enum": ["Foreman", "Journeyman", "Apprentice", "Helper", "PM", "Office"]
    },
    "status": {
      "type": "string",
      "enum": ["Active", "Inactive", "On Leave"]
    },
    "license_number": { "type": "string" },
    "license_expiry": { "type": "string", "format": "date" },
    "phone": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "current_job_id": { "type": "string" },
    "hire_date": { "type": "string", "format": "date" },
    "pay_rate": { "type": "number", "minimum": 0 },
    "scorecard": {
      "type": "object",
      "properties": {
        "speed": { "type": "integer", "minimum": 1, "maximum": 4 },
        "quality": { "type": "integer", "minimum": 1, "maximum": 4 },
        "cleanliness": { "type": "integer", "minimum": 1, "maximum": 4 },
        "communication": { "type": "integer", "minimum": 1, "maximum": 4 },
        "safety": { "type": "integer", "minimum": 1, "maximum": 4 },
        "team": { "type": "integer", "minimum": 1, "maximum": 4 },
        "last_reviewed": { "type": "string", "format": "date" }
      }
    },
    "notes": { "type": "string" }
  }
}
